root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Windows PowerShell 5.1 без BOM читает файл как ANSI и молча ломает разбор
# кириллицы. Это не стилистика — это работоспособность.
[*.ps1]
charset = utf-8-bom
end_of_line = crlf

[*.{md,yml,yaml}]
trim_trailing_whitespace = false
