    "ui-automation",
    "accessibility",
    "ocr",
    "win32",
    "windows11"
  ],
  "engines": { "node": ">=20" },
  "bin": { "desk-mcp": "server.mjs" },
  "files": ["server.mjs", "worker.ps1", "bench.ps1", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "start": "node server.mjs",
    "test": "node smoke.mjs",
    "check": "node --check server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.25.0"
  }
}
