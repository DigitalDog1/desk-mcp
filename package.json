{
  "name": "desk-mcp",
  "version": "1.5.1",
  "type": "module",
  "license": "Apache-2.0",
  "description": "MCP server for automating the Windows desktop: UI Automation, MSAA, Chrome DevTools Protocol, OCR and WinAPI input. Node.js plus the PowerShell that ships with Windows, no native modules.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "windows",
    "computer-use",
    "automation",
    "ui-automation",
    "accessibility",
    "ocr",
    "win32",
    "windows11"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DigitalDog1/desk-mcp.git"
  },
  "homepage": "https://github.com/DigitalDog1/desk-mcp#readme",
  "bugs": {
    "url": "https://github.com/DigitalDog1/desk-mcp/issues"
  },
  "author": "DigitalDog1",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "desk-mcp": "server.mjs"
  },
  "files": [
    "server.mjs",
    "lib",
    "worker.ps1",
    "uia-native.cs",
    "bench.ps1",
    "examples/demo-app.ps1",
    "examples/demo.mjs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.ru.md"
  ],
  "scripts": {
    "start": "node server.mjs",
    "test": "npm run test:unit && npm run test:smoke",
    "check": "node --check server.mjs && node --check lib/worker.mjs && node --check lib/batch.mjs && node --check lib/cdp.mjs",
    "bench": "node benchmark.mjs",
    "bench:full": "node bench-full.mjs",
    "bench:fonts": "node benchmark.mjs",
    "check:docs": "node check-docs.mjs",
    "test:unit": "node --test test/*.test.mjs",
    "test:smoke": "node smoke.mjs",
    "check:package": "node check-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  }
}
