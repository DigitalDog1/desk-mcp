{
  "name": "desk-mcp",
  "version": "1.5.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "MCP server for automating the Windows desktop: UI Automation, MSAA, Chrome DevTools Protocol, OCR and WinAPI input. Node.js plus the PowerShell that ships with Windows, no native modules.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "windows",
    "computer-use",
    "automation",
    "ui-automation",
    "accessibility",
    "ocr",
    "win32",
    "windows11"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DigitalDog1/desk-mcp.git"
  },
  "homepage": "https://github.com/DigitalDog1/desk-mcp#readme",
  "bugs": {
    "url": "https://github.com/DigitalDog1/desk-mcp/issues"
  },
  "author": "DigitalDog1",
  "engines": { "node": ">=20" },
  "bin": { "desk-mcp": "server.mjs" },
  "files": [
    "server.mjs",
    "worker.ps1",
    "uia-native.cs",
    "bench.ps1",
    "examples/demo-app.ps1",
    "examples/demo.mjs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "start": "node server.mjs",
    "test": "node smoke.mjs",
    "check": "node --check server.mjs",
    "bench": "node bench-tokens.mjs",
    "bench:full": "node bench-full.mjs",
    "bench:fonts": "node bench-fonts.mjs",
    "check:docs": "node check-docs.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.25.0"
  }
}